# Bot token from the Discord Developer Portal (Bot tab). Keep this secret.
DISCORD_TOKEN=

# Application ID from the Developer Portal (General Information tab).
CLIENT_ID=

# Optional. If set, slash commands are registered only in this server and
# appear instantly. If unset, commands are registered globally (can take up
# to an hour to propagate the first time).
GUILD_ID=

# Optional. IANA time zone that decides when the daily puzzle rolls over.
# Default: America/New_York
TIMEZONE=

# Optional. Where the SQLite database lives. Default: ./data/loldle.sqlite
DB_PATH=

# Optional. Extra salt mixed into the daily champion selection so the
# sequence can't be predicted from the public code. Any string.
DAILY_SEED=

# Optional. Discord user ID allowed to use /msg (send a message as the bot).
# Right-click your name in Discord with Developer Mode on -> Copy User ID.
# If unset, /msg is disabled.
OWNER_ID=
