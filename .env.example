# Bot token from the Discord Developer Portal (Bot tab). Keep this secret.
DISCORD_TOKEN=

# Application ID from the Developer Portal (General Information tab).
CLIENT_ID=

# Optional. If set, slash commands are registered only in this server and
# appear instantly. If unset, commands are registered globally (can take up
# to an hour to propagate the first time).
GUILD_ID=

# Optional. IANA time zone that decides when the daily puzzle rolls over.
# Default: America/Los_Angeles
TIMEZONE=

# Optional. Where the SQLite database lives. Default: ./data/loldle.sqlite
DB_PATH=

# Optional. Extra salt mixed into the daily champion selection so the
# sequence can't be predicted from the public code. Any string.
DAILY_SEED=

# Optional. Discord user ID allowed to use /msg (send a message as the bot).
# Right-click your name in Discord with Developer Mode on -> Copy User ID.
# If unset, /msg is disabled.
OWNER_ID=

# ---- @mention chatbot (optional) ------------------------------------------
# Set CHAT_API_KEY to enable. When enabled the bot needs the "Message Content
# Intent" toggled on in the Developer Portal (Bot tab -> Privileged Gateway
# Intents), and replies when @mentioned or when someone replies to it.
# Any OpenAI-compatible chat-completions endpoint works.
CHAT_API_KEY=
# Default: https://models.relace.ai/v1/chat/completions
CHAT_API_URL=
# Default: z-ai/glm-5.3-flash
CHAT_MODEL=
# Persona/display name used in prompts. Default: Faker
CHAT_NAME=
# Send attached images to the model (needs a vision model). Default: true
CHAT_IMAGES=
# reasoning_effort sent to the model; empty string to omit. Default: low
CHAT_REASONING_EFFORT=
# Guardrails. Defaults: 12 messages of context, 5 replies/user/minute, 500 replies/day.
CHAT_CONTEXT_MESSAGES=
CHAT_USER_PER_MINUTE=
CHAT_DAILY_CAP=
